# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente local.
# O ".env" nunca deve ser commitado (já está no .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hydra_db
DB_USER=root
DB_PASS=

# Conexão persistente com o MySQL: cada processo do Apache reaproveita a
# conexão entre requisições em vez de abrir uma nova a cada chamada da API.
# Grande ganho quando o banco fica em outro servidor (ex.: Render + MySQL
# externo). Cada processo segura uma conexão aberta, então confira o limite
# de conexões do plano do banco antes de ligar.
DB_PERSISTENT=false

# Com APP_DEBUG=true, a resposta de erro "Falha ao conectar ao banco de dados"
# passa a incluir o motivo real da recusa (host, usuário e mensagem do MySQL —
# nunca a senha), útil para diagnosticar a conexão. Mantenha "false" em produção;
# o motivo sempre vai para o log de erro do servidor, independentemente disso.
APP_DEBUG=false

# Deslocamento de fuso usado na conexão com o MySQL. Define em que horario
# CURRENT_TIMESTAMP grava data_criacao e data_movimentacao. O padrão -03:00 e
# o horario de Brasília; sem isso o banco usaria o fuso do servidor (UTC na
# maioria das hospedagens) e o historico apareceria 3 horas adiantado.
APP_TIMEZONE_OFFSET=-03:00

# Ambiente. Use "local" apenas na sua máquina: ele libera o curinga de CORS
# abaixo e faz o código de recuperação de senha voltar na resposta da API
# quando não há Brevo configurado. Em produção deixe "production".
APP_ENV=local

# Fuso usado pelo PHP. Precisa corresponder a APP_TIMEZONE_OFFSET acima:
# prazos calculados no PHP (validade do código de recuperação) são
# comparados com NOW() do MySQL, e fusos diferentes esticam esses prazos.
APP_TIMEZONE=America/Sao_Paulo

# Origens locais autorizadas a chamar a API (CORS), separadas por vírgula.
# Inclui localhost e 127.0.0.1, pois são origens diferentes para o navegador.
# Em produção, informe somente a origem real do front-end; se front e API
# forem servidos pelo mesmo domínio, pode ficar vazio.
CORS_ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500


# API do Brevo (https://app.brevo.com/settings/keys/api) usada para
# enviar o código de verificação da tela de Recuperar Senha (Fig. 15) via
# HTTPS. Se BREVO_API_KEY ficar vazio, o e-mail não é enviado e o código
# volta na resposta da API (codigo_dev) só para permitir testar o fluxo
# localmente sem uma conta no Brevo. SMTP direto (porta 25/465/587) não é
# usado porque provedores como o Render bloqueiam essas portas de saída.
# MAIL_FROM precisa estar verificado no Brevo (não exige domínio próprio).
BREVO_API_KEY=
MAIL_FROM=no-reply@hydra.local
MAIL_FROM_NAME=Hydra PDV

# OAuth Mercado Pago para Pix dinâmico. Crie uma aplicação em
# https://www.mercadopago.com.br/developers/panel e cadastre como redirect URI:
# https://SEU-DOMINIO/api/pix/mercadopago/callback
# Em desenvolvimento, use o endereço público de um túnel (ex.: ngrok), pois
# o OAuth e o retorno do navegador precisam alcançar o Hydra.Back.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=
HYDRA_FRONTEND_URL=http://localhost:5500/Hydra.Front/pages/configuracoes-loja.html

# Chave AES-256-GCM (32 bytes em Base64) para proteger tokens de cada mercado.
# Gere com: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Guarde a mesma chave no ambiente do servidor; perdê-la invalida as conexões.
HYDRA_ENCRYPTION_KEY=

# Alertas diários pelo WhatsApp Cloud API oficial da Meta. Com envio
# desativado, os resumos selecionados para WhatsApp seguem por e-mail.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_RESUMO=hydra_resumo_diario
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
ALERTAS_CRON_TOKEN=
APP_URL=http://localhost:5500/Hydra.Front
