# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente local.
# O ".env" nunca deve ser commitado (já está no .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hydra_db
DB_USER=root
DB_PASS=

# Origem permitida para requisições do front-end (CORS) durante o desenvolvimento.
# Ex.: http://localhost:5500 se o front for servido pelo Live Server / http.server.
CORS_ALLOWED_ORIGIN=*

# Duração da sessão de login "lembrar de mim", em dias.
REMEMBER_ME_DAYS=30

# SMTP usado para enviar o código de verificação da tela de Recuperar
# Senha (Fig. 15). Se MAIL_HOST ficar vazio, o e-mail não é enviado e o
# código volta na resposta da API (reset_token_dev) só para permitir
# testar o fluxo localmente sem um servidor SMTP configurado.
# Ex.: Gmail -> MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USER=seuemail@gmail.com, MAIL_PASS=<senha de app>.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@hydra.local
MAIL_FROM_NAME=Hydra PDV
